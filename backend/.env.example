# Copy to .env and fill in. Never commit .env.

# Free key from https://console.groq.com/keys. Enables the AI assistant (tool-using agent, English/Hindi)
# and reading bills from photos. Without it, Stockora still runs with rule-based answers.
GROQ_API_KEY=
# Optional model overrides (check https://console.groq.com/docs/models for current IDs)
# Defaults (checked 11 Nov 2026; the older llama-3.x and llama-4-scout IDs were shut down by Groq):
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GROQ_REASONING_EFFORT=low


# Local SQLite database file (created and seeded with a demo store on first run)
STOCKORA_DB=stockora.db
STOCKORA_STORE_ID=1

# Set to require an X-API-Key header on every request (recommended when deployed)
STOCKORA_API_KEY=
CORS_ORIGINS=http://localhost:3000
